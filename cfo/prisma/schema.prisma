// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Um registro por periodo de balanco/balancete importado. Guarda os campos ja
// normalizados de DRE e Balanco Patrimonial usados pelo motor de indicadores
// (src/lib/financial/indicators.ts), mais o payload bruto da IA para auditoria.
//
// Espelha as abas Ativo/Passivo/DRE da planilha "Analise de Balanco para Credito"
// linha a linha, para permitir Analise Vertical (AV) e Horizontal (AH) fieis ao
// modelo usado pelo banco.
//
// Valores monetarios em Float (nao Decimal) porque o SQLite nao tem tipo
// decimal nativo - para uso pessoal com 2 casas decimais isso nao traz erro
// de arredondamento perceptivel.
model FinancialStatement {
  id             String   @id @default(uuid())
  periodLabel    String
  referenceDate  DateTime
  periodDays     Int
  sourceFileName String

  // DRE
  receitaBruta                 Float
  deducoes                     Float
  receitaLiquida                Float
  cmv                           Float
  lucroBruto                    Float
  outrasReceitasOperacionais    Float @default(0)
  despesasGerais                 Float @default(0)
  despesasComerciais             Float @default(0)
  despesasTributarias            Float @default(0)
  depreciacaoAmortizacao         Float
  outrasDespesasOperacionais     Float @default(0)
  resultadoAtividade             Float // EBIT
  receitasFinanceiras            Float @default(0)
  despesasFinanceiras            Float @default(0)
  variacaoCambial                 Float @default(0)
  resultadoNaoOperacional        Float @default(0)
  impostoRenda                   Float
  participacoes                   Float @default(0)
  lucroLiquido                   Float

  // Ativo Circulante
  caixaEquivalentes             Float
  titulosValoresMobiliarios     Float @default(0)
  contasReceberClientes         Float
  estoques                       Float
  adiantamentoFornecedores      Float @default(0)
  outrosAtivosOperacionaisCirc   Float @default(0)
  outrosAtivosNaoOperacionaisCirc Float @default(0)

  // Ativo Nao Circulante
  contasReceberColigadas        Float @default(0)
  investimentos                  Float @default(0)
  imobilizado                    Float @default(0)
  intangivel                     Float @default(0)
  outrosAtivosNaoCirculantes     Float @default(0)

  // Passivo Circulante
  fornecedores                   Float
  salariosEncargos                Float @default(0)
  impostosContribuicoes          Float @default(0)
  emprestimosCurtoPrazo          Float
  irAPagar                        Float @default(0)
  emprestimosColigadasCP         Float @default(0)
  dividendosAPagar                Float @default(0)
  adiantamentosClientes          Float @default(0)
  outrosPassivosCirc              Float @default(0)

  // Passivo Nao Circulante
  emprestimosLongoPrazo          Float
  outrosPassivosNaoCirc           Float @default(0)

  // Patrimonio Liquido
  capitalSocial                   Float @default(0)
  reservas                        Float @default(0)
  lucrosPrejuizosAcumulados       Float @default(0)
  outrosResultadosAbrangentes    Float @default(0)

  // Exposicao cambial - nem todo balancete discrimina moeda estrangeira separadamente
  ativosMoedaEstrangeira   Float?
  passivosMoedaEstrangeira Float?

  extractedRaw Json
  aiInsights   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referenceDate])
  @@map("financial_statements")
}
