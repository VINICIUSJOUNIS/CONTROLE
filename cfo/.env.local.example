# Banco SQLite local - caminho do arquivo, relativo a pasta prisma/
DATABASE_URL="file:./dev.db"

# Chave da API da Anthropic (opcional) - so necessaria se voce usar os
# recursos de IA (extracao automatica do PDF e analise de riscos). Sem ela,
# o sistema funciona normalmente com lancamento manual dos balancetes.
ANTHROPIC_API_KEY=
