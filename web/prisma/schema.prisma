// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  TESOURARIA
  FINANCEIRO
  CONSULTA
}

enum LoanStatus {
  ATIVO
  LIQUIDADO
  EM_ATRASO
}

enum AccStatus {
  EM_ABERTO
  LIQUIDADO
  EM_ATRASO
}

enum Indexer {
  CDI
  SOFR
  PRE_FIXADO
  SELIC
}

enum AmortizationSystem {
  PRICE
  SAC
  BULLET
}

// Periodo de referencia da taxa de juros informada no contrato (ex: 1,99% "ao mes").
// O calculo de juros usa dias corridos proporcionais a esse periodo (mes comercial de
// 30 dias, semestre de 180 dias, ano comercial de 365 dias).
enum RateBasis {
  MENSAL
  SEMESTRAL
  ANUAL
}

enum Currency {
  USD
  EUR
}

enum ClientType {
  INTERNO
  EXTERNO
}

model Profile {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(CONSULTA)
  createdAt DateTime @default(now())

  @@map("profiles")
}

model Bank {
  id            String         @id @default(uuid())
  name          String         @unique
  color         String
  loans         Loan[]
  accOperations AccOperation[]
  createdAt     DateTime       @default(now())

  @@map("banks")
}

model Loan {
  id                 String             @id @default(uuid())
  bank               Bank               @relation(fields: [bankId], references: [id])
  bankId             String
  contractNumber     String             @unique
  purpose            String
  contractedValue    Decimal            @db.Decimal(18, 2)
  netValue           Decimal            @db.Decimal(18, 2)
  interestRate       Decimal            @db.Decimal(6, 2)
  rateBasis          RateBasis          @default(ANUAL)
  indexer            Indexer
  spread             Decimal            @db.Decimal(6, 2)
  amortizationSystem AmortizationSystem
  contractDate       DateTime           @db.Date
  firstDueDate       DateTime           @db.Date
  lastDueDate        DateTime           @db.Date
  settlementDate     DateTime?          @db.Date
  installments       Int
  periodicity        String
  guarantee          String
  iof                Decimal            @default(0) @db.Decimal(18, 2)
  hasInsurance       Boolean            @default(false)
  insuranceCost      Decimal            @default(0) @db.Decimal(18, 2)
  otherCosts         Decimal            @default(0) @db.Decimal(18, 2)
  status             LoanStatus         @default(ATIVO)
  installmentRecords LoanInstallment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([bankId])
  @@index([status])
  @@map("loans")
}

// Dados reais de uma parcela do emprestimo: vencimento corrigido (quando difere
// do calculado) e/ou pagamento efetuado (data e valor pago). Ambos opcionais e
// independentes - uma parcela pode ter so o vencimento corrigido, so o pagamento,
// ou os dois.
model LoanInstallment {
  id         String    @id @default(uuid())
  loan       Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId     String
  numero     Int
  vencimento DateTime? @db.Date
  paidAt     DateTime? @db.Date
  paidValue  Decimal?  @db.Decimal(18, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([loanId, numero])
  @@map("loan_installments")
}

// Um registro por periodo de balanco/balancete importado (modulo Analise de
// Credito, em /credito). Guarda os campos ja normalizados de DRE e Balanco
// Patrimonial usados pelo motor de indicadores (src/lib/financial/indicators.ts),
// mais o payload bruto da IA para auditoria. Espelha as abas Ativo/Passivo/DRE
// da planilha "Analise de Balanco para Credito" linha a linha, para permitir
// Analise Vertical (AV) e Horizontal (AH) fieis ao modelo usado pelo banco.
model FinancialStatement {
  id             String   @id @default(uuid())
  periodLabel    String
  referenceDate  DateTime @db.Date
  periodDays     Int
  sourceFileName String

  // DRE
  receitaBruta                    Decimal @db.Decimal(18, 2)
  deducoes                        Decimal @db.Decimal(18, 2)
  receitaLiquida                  Decimal @db.Decimal(18, 2)
  cmv                             Decimal @db.Decimal(18, 2)
  lucroBruto                      Decimal @db.Decimal(18, 2)
  outrasReceitasOperacionais      Decimal @default(0) @db.Decimal(18, 2)
  despesasGerais                  Decimal @default(0) @db.Decimal(18, 2)
  despesasComerciais              Decimal @default(0) @db.Decimal(18, 2)
  despesasTributarias             Decimal @default(0) @db.Decimal(18, 2)
  depreciacaoAmortizacao          Decimal @db.Decimal(18, 2)
  outrasDespesasOperacionais      Decimal @default(0) @db.Decimal(18, 2)
  resultadoAtividade              Decimal @db.Decimal(18, 2) // EBIT
  receitasFinanceiras             Decimal @default(0) @db.Decimal(18, 2)
  despesasFinanceiras             Decimal @default(0) @db.Decimal(18, 2)
  variacaoCambial                 Decimal @default(0) @db.Decimal(18, 2)
  resultadoNaoOperacional         Decimal @default(0) @db.Decimal(18, 2)
  impostoRenda                    Decimal @db.Decimal(18, 2)
  participacoes                   Decimal @default(0) @db.Decimal(18, 2)
  lucroLiquido                    Decimal @db.Decimal(18, 2)

  // Ativo Circulante
  caixaEquivalentes               Decimal @db.Decimal(18, 2)
  titulosValoresMobiliarios       Decimal @default(0) @db.Decimal(18, 2)
  contasReceberClientes           Decimal @db.Decimal(18, 2)
  estoques                        Decimal @db.Decimal(18, 2)
  adiantamentoFornecedores        Decimal @default(0) @db.Decimal(18, 2)
  outrosAtivosOperacionaisCirc    Decimal @default(0) @db.Decimal(18, 2)
  outrosAtivosNaoOperacionaisCirc Decimal @default(0) @db.Decimal(18, 2)

  // Ativo Nao Circulante
  contasReceberColigadas          Decimal @default(0) @db.Decimal(18, 2)
  investimentos                   Decimal @default(0) @db.Decimal(18, 2)
  imobilizado                     Decimal @default(0) @db.Decimal(18, 2)
  intangivel                      Decimal @default(0) @db.Decimal(18, 2)
  outrosAtivosNaoCirculantes      Decimal @default(0) @db.Decimal(18, 2)

  // Passivo Circulante
  fornecedores                    Decimal @db.Decimal(18, 2)
  salariosEncargos                Decimal @default(0) @db.Decimal(18, 2)
  impostosContribuicoes           Decimal @default(0) @db.Decimal(18, 2)
  emprestimosCurtoPrazo           Decimal @db.Decimal(18, 2)
  irAPagar                        Decimal @default(0) @db.Decimal(18, 2)
  emprestimosColigadasCP          Decimal @default(0) @db.Decimal(18, 2)
  dividendosAPagar                Decimal @default(0) @db.Decimal(18, 2)
  adiantamentosClientes           Decimal @default(0) @db.Decimal(18, 2)
  outrosPassivosCirc              Decimal @default(0) @db.Decimal(18, 2)

  // Passivo Nao Circulante
  emprestimosLongoPrazo           Decimal @db.Decimal(18, 2)
  outrosPassivosNaoCirc           Decimal @default(0) @db.Decimal(18, 2)

  // Patrimonio Liquido
  capitalSocial                   Decimal @default(0) @db.Decimal(18, 2)
  reservas                        Decimal @default(0) @db.Decimal(18, 2)
  lucrosPrejuizosAcumulados       Decimal @default(0) @db.Decimal(18, 2)
  outrosResultadosAbrangentes     Decimal @default(0) @db.Decimal(18, 2)

  // Exposicao cambial - nem todo balancete discrimina moeda estrangeira separadamente
  ativosMoedaEstrangeira   Decimal? @db.Decimal(18, 2)
  passivosMoedaEstrangeira Decimal? @db.Decimal(18, 2)

  extractedRaw Json
  aiInsights   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referenceDate])
  @@map("financial_statements")
}

model AccOperation {
  id                     String    @id @default(uuid())
  bank                   Bank      @relation(fields: [bankId], references: [id])
  bankId                 String
  accNumber              String    @unique
  exchangeContractNumber String
  exporter               String
  foreignClient          String
  invoice                String
  country                String
  currency               Currency
  invoiceValue           Decimal   @db.Decimal(18, 2)
  contractedValueForeign Decimal   @db.Decimal(18, 2)
  receivedValueBRL       Decimal   @db.Decimal(18, 2)
  spotRate               Decimal   @db.Decimal(10, 4)
  closingRate            Decimal   @db.Decimal(10, 4)
  ptaxContracting        Decimal   @db.Decimal(10, 4)
  ptaxSettlement         Decimal   @db.Decimal(10, 4)
  contractDate           DateTime  @db.Date
  closingDate            DateTime? @db.Date
  settlementDate         DateTime  @db.Date
  interestRate           Decimal   @db.Decimal(6, 2)
  iof                    Decimal   @db.Decimal(18, 2)
  exchangeSpread         Decimal   @db.Decimal(10, 4)
  exchangeVariationValue Decimal   @default(0) @db.Decimal(10, 4)
  bankFees               Decimal   @db.Decimal(18, 2)
  hasInsurance           Boolean   @default(false)
  insuranceCost          Decimal   @default(0) @db.Decimal(18, 2)
  otherCosts             Decimal   @default(0) @db.Decimal(18, 2)
  status                 AccStatus @default(EM_ABERTO)
  baixas                 AccBaixa[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([bankId])
  @@index([status])
  @@map("acc_operations")
}

// Quitacao parcial de um ACC: o exportador liquida o adiantamento em tranches
// (conforme recebe pagamentos do comprador estrangeiro). Cada tranche tem seu
// proprio valor, data e cambio - os juros de cada uma sao calculados
// individualmente (valorUSD x taxa x dias/360, da contratacao ate a data
// daquela tranche), nao um calculo unico sobre o saldo total.
model AccBaixa {
  id             String       @id @default(uuid())
  accOperation   AccOperation @relation(fields: [accOperationId], references: [id], onDelete: Cascade)
  accOperationId String
  valorUSD       Decimal      @db.Decimal(18, 2)
  dataQuitacao   DateTime     @db.Date
  closingRate    Decimal      @db.Decimal(10, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accOperationId])
  @@map("acc_baixas")
}

// Controle de faturamento (vendas de cafe): cliente interno (mercado nacional)
// ou externo (exportacao). Quantidade sempre em kg - sacas (60kg) e calculado
// na leitura, nao armazenado. Pais e quantidade de conteineres so fazem
// sentido para cliente externo; valueUSD idem (cliente interno fatura so em
// R$).
model Sale {
  id            String     @id @default(uuid())
  clientName    String
  clientType    ClientType
  quantityKg    Decimal    @db.Decimal(18, 2)
  country       String?
  containers20  Int?
  containers40  Int?
  saleDate      DateTime   @db.Date
  valueBRL      Decimal    @db.Decimal(18, 2)
  valueUSD      Decimal?   @db.Decimal(18, 2)
  diferencial   Decimal?   @db.Decimal(10, 4)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([clientType])
  @@index([saleDate])
  @@map("sales")
}

// Devolucao de venda: registrada separada da venda original (nao um estorno
// vinculado a uma Sale especifica), pois as notas fiscais de devolucao do
// relatorio de origem nao referenciam a venda que as gerou. Quantidade em kg
// (sacas de 60kg calculadas na leitura, como em Sale) e valor em R$ entram
// como abatimento dos totais de faturamento do periodo correspondente.
model SaleReturn {
  id          String   @id @default(uuid())
  clientName  String
  quantityKg  Decimal  @db.Decimal(18, 2)
  returnDate  DateTime @db.Date
  valueBRL    Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([returnDate])
  @@map("sale_returns")
}

enum Side {
  COMPRA
  VENDA
}

enum ContractType {
  NDF
  TRAVA
}

enum HedgeStatus {
  A_LIQUIDAR
  LIQUIDADA
}

enum StatusContrato {
  CONTRATO_ASSINADO
  PRE_EMBARQUE
  ESTUFAGEM_PORTO
  EMBARCADO
  CARGA_DESTINO
  CONTRATO_FINALIZADO
}

model Corretora {
  id              String               @id @default(uuid())
  name            String               @unique
  color           String
  hedgeOperations HedgeOperation[]
  contratos       ContratoExportacao[]
  createdAt       DateTime             @default(now())

  @@map("corretoras")
}

model HedgeOperation {
  id                    String       @id @default(uuid())
  corretora             Corretora    @relation(fields: [corretoraId], references: [id])
  corretoraId           String
  contractType          ContractType @default(NDF)
  side                  Side?
  contractDate          DateTime     @db.Date
  vencimento            DateTime     @db.Date
  valorUsd              Decimal      @db.Decimal(18, 2)
  liquidacaoParcialUsd  Decimal      @default(0) @db.Decimal(18, 2)
  saldoUsd              Decimal      @default(0) @db.Decimal(18, 2)
  nivelCompra           Decimal      @default(0) @db.Decimal(10, 4)
  nivelVenda            Decimal      @default(0) @db.Decimal(10, 4)
  desagioValor          Decimal      @default(0) @db.Decimal(18, 2)
  totalReais            Decimal      @default(0) @db.Decimal(18, 2)
  status                HedgeStatus  @default(A_LIQUIDAR)
  observacao            String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([corretoraId])
  @@index([status])
  @@map("hedge_operations")
}

model Cliente {
  id        String              @id @default(uuid())
  name      String              @unique
  city      String?
  country   String
  email     String?
  phone     String?
  contratos ContratoExportacao[]
  createdAt DateTime            @default(now())

  @@map("clientes")
}

model ContratoExportacao {
  id             String          @id @default(uuid())
  contractNumber String          @unique
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  clienteId      String
  corretora      Corretora?      @relation(fields: [corretoraId], references: [id])
  corretoraId    String?
  country        String          @default("")
  valorUsd       Decimal         @default(0) @db.Decimal(18, 2)
  dataEstufagem  DateTime?       @db.Date
  dataEmbarque   DateTime?       @db.Date
  dataChegada    DateTime?       @db.Date
  status         StatusContrato  @default(CONTRATO_ASSINADO)

  // Recebimento do contrato — controle financeiro do valor a receber do cliente/RTS.
  quantSacas                    Int?
  adiantamentoUsd                Decimal   @default(0) @db.Decimal(18, 2)
  dataAdiantamento                DateTime? @db.Date
  financiadoPelaRts              Boolean   @default(false)
  valorFinanciadoRtsUsd          Decimal   @default(0) @db.Decimal(18, 2)
  dataLiberacaoFinanciamentoRts DateTime? @db.Date
  previsaoPagamentoCliente      DateTime? @db.Date
  saldoAReceberRtsUsd            Decimal   @default(0) @db.Decimal(18, 2)
  valorRecebidoRtsUsd            Decimal   @default(0) @db.Decimal(18, 2)
  dataRecebimentoRts              DateTime? @db.Date
  obsRecebimento                 String?

  // Despesas do contrato (R$) — compoe o custo final da operacao de exportacao.
  despachante              Decimal @default(0) @db.Decimal(18, 2)
  certificados             Decimal @default(0) @db.Decimal(18, 2)
  freteTerrestre           Decimal @default(0) @db.Decimal(18, 2)
  freteMaritimo            Decimal @default(0) @db.Decimal(18, 2)
  taxasLocaisArmador       Decimal @default(0) @db.Decimal(18, 2)
  fumigacao                Decimal @default(0) @db.Decimal(18, 2)
  embalagens               Decimal @default(0) @db.Decimal(18, 2)
  inspecao                 Decimal @default(0) @db.Decimal(18, 2)
  despesasPortuarias       Decimal @default(0) @db.Decimal(18, 2)
  armazem                  Decimal @default(0) @db.Decimal(18, 2)
  envioAmostra             Decimal @default(0) @db.Decimal(18, 2)
  marcacaoSacaria          Decimal @default(0) @db.Decimal(18, 2)
  envioDocumentacao        Decimal @default(0) @db.Decimal(18, 2)
  telexRelease             Decimal @default(0) @db.Decimal(18, 2)
  legalizacao              Decimal @default(0) @db.Decimal(18, 2)
  financiamentoRts         Decimal @default(0) @db.Decimal(18, 2)
  diariaContainerDetention Decimal @default(0) @db.Decimal(18, 2)
  despesasRedex            Decimal @default(0) @db.Decimal(18, 2)
  estadiaContainer         Decimal @default(0) @db.Decimal(18, 2)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("contratos_exportacao")
}
